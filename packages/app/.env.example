# Copy to .env.local (not committed) and fill in to turn the online features on. Leave empty to build without them.

# Base URL of the PokeDraftChamps API worker (packages/api), no trailing slash, e.g. https://pdc-api.example.workers.dev
# Empty: the daily leaderboard shows "not configured" and the app never makes a request.
VITE_PDC_API_URL=

# Cloudflare Web Analytics token (cookieless page-view beacon). Empty: no beacon script is added.
VITE_CF_BEACON_TOKEN=
